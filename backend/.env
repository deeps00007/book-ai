# Fireworks AI
FIREWORKS_API_KEY=fw_URSNoRJPREb9orbdGzC23N
FIREWORKS_BASE_URL=https://api.fireworks.ai/inference/v1

# OpenAI (optional)
OPENAI_API_KEY=

# Gemini (optional)
GEMINI_API_KEY=

# Groq (optional)
GROQ_API_KEY=

# Anthropic (optional)
ANTHROPIC_API_KEY=

# Database (local: SQLite, production: PostgreSQL)
USE_SQLITE=true
SQLITE_PATH=./bookai.db
DATABASE_URL=postgresql+asyncpg://bookai:bookai_secret@db:5432/bookai
DATABASE_URL_SYNC=postgresql+psycopg2://bookai:bookai_secret@db:5432/bookai

# Redis (not needed for local dev)
REDIS_URL=redis://redis:6379/0

# Auth
SECRET_KEY=dev-secret-key-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Upload
UPLOAD_DIR=./uploads

# Embedding
EMBEDDING_MODEL=nomic-ai/nomic-embed-text-v1.5
EMBEDDING_DIMENSION=768
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# LLM Defaults
DEFAULT_LLM_MODEL=accounts/fireworks/models/deepseek-v4-pro
DEFAULT_LLM_PROVIDER=fireworks
TEMPERATURE=0.2
MAX_TOKENS=4096
